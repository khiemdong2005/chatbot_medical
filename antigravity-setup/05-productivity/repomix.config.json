{
  "output": {
    "filePath": "repomix-context.md",
    "style": "markdown",
    "headerText": "MediMind Clinical AI Codebase Snapshot",
    "removeComments": false,
    "showLineNumbers": true
  },
  "include": [
    "core/**/*.py",
    "templates/**/*.html",
    "static/js/**/*.js",
    "static/css/**/*.css",
    "app.py"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "*.db",
      "*.png",
      "*.jpg"
    ]
  }
}
