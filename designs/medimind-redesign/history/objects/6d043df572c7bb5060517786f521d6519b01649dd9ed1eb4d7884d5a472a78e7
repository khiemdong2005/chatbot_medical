<style>
body{margin:0;background:#edf7fb;color:#12263a;font-family:'DM Sans',Arial,sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:24px clamp(24px,5vw,76px) 54px;background:radial-gradient(ellipse at 12% 0%,#d9f0fa 0,transparent 34%),linear-gradient(135deg,#f3fafc 0%,#eaf5fa 50%,#f7fbfc 100%)}.topbar{max-width:1288px;margin:0 auto 44px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px}.brand-mark{width:42px;height:42px;border-radius:14px;background:#087da7;color:white;display:grid;place-items:center;box-shadow:0 8px 18px #087da733;font-size:21px}.brand-name{font:800 16px Manrope,sans-serif;letter-spacing:-.03em}.brand-caption{font-size:11px;color:#668095;margin-top:2px}.nav{display:flex;align-items:center;gap:8px;background:#ffffffb8;border:1px solid #d9eaf2;border-radius:999px;padding:6px;box-shadow:0 5px 18px #1d4a5b0d}.nav span{font-size:12px;color:#6c8191;padding:9px 14px;border-radius:999px}.nav .nav-active{background:#e2f4fa;color:#087da7;font-weight:700}.profile{font-size:12px;color:#587184;background:#fff;border:1px solid #dbeaf1;border-radius:999px;padding:10px 15px}.main{max-width:1288px;margin:auto}.intro{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:22px}.eyebrow{display:flex;align-items:center;gap:8px;color:#087da7;font-size:11px;letter-spacing:.13em;font-weight:800}.eyebrow .dot{width:7px;height:7px;border-radius:50%;background:#15a7bd;box-shadow:0 0 0 4px #d8f2f5}h1{font:800 clamp(30px,3.3vw,44px)/1.12 Manrope,sans-serif;letter-spacing:-.055em;margin:12px 0 7px;color:#132a40}.subtitle{font-size:14px;color:#627a8d;margin:0}.privacy{font-size:11px;color:#638093;padding:10px 14px;background:#ffffff9c;border:1px solid #dcebf1;border-radius:99px;white-space:nowrap}.search-panel{padding:14px;background:#fff;border:1px solid #dceaf0;border-radius:18px;box-shadow:0 10px 32px #27566a0b;margin-bottom:16px}.search-row{display:flex;align-items:center;gap:12px}.search-icon{font-size:19px;color:#1685a8;padding-left:9px}.search-input{flex:1;min-width:0;border:0;outline:0;font:500 15px 'DM Sans',sans-serif;color:#18354b;background:transparent}.search-input::placeholder{color:#91a4b2}.search-button{border:0;border-radius:12px;background:#087da7;color:white;padding:13px 20px;font:700 13px 'DM Sans',sans-serif;box-shadow:0 6px 14px #087da733;cursor:pointer}.search-button:hover{background:#066d94}.search-bottom{display:flex;align-items:center;gap:9px;margin-top:12px;padding:0 8px;flex-wrap:wrap}.hint{font-size:11px;color:#8195a3;margin-right:3px}.quick-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid #dfebf0;background:#f7fbfd;color:#536c7d;padding:7px 12px;border-radius:999px;font-size:11px;cursor:pointer}.quick-chip.active{background:#e1f5f8;color:#087da7;border-color:#b8e5ec;font-weight:700}.results-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(340px,.9fr);gap:22px;align-items:start;margin-top:30px}.results-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:16px}.results-kicker{font-size:10px;font-weight:800;letter-spacing:.13em;color:#1683a4}.results-title{font:800 21px Manrope,sans-serif;letter-spacing:-.04em;color:#142e43;margin:5px 0 3px}.results-caption{font-size:12px;color:#718899}.count{font-size:11px;color:#658093;padding:8px 11px;border:1px solid #dceaf0;background:#ffffffb8;border-radius:999px;white-space:nowrap}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.recipe-card{box-sizing:border-box;text-align:left;width:100%;border:1px solid #dceaf0;border-radius:17px;background:#fff;padding:15px;cursor:pointer;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease;color:#173247}.recipe-card:hover{transform:translateY(-2px);box-shadow:0 10px 24px #1a557012;border-color:#a9d9e5}.recipe-card.chosen{border:1.5px solid #1489aa;box-shadow:0 0 0 3px #d9f2f7}.card-top{display:flex;justify-content:space-between;align-items:start;gap:12px}.food-icon{width:48px;height:48px;border-radius:15px;background:#e7f5f8;display:grid;place-items:center;font-size:24px}.tag{font-size:9px;font-weight:800;letter-spacing:.08em;color:#087da7;background:#e8f6fa;border-radius:99px;padding:6px 9px}.recipe-card h3{font:700 15px/1.35 Manrope,sans-serif;letter-spacing:-.025em;margin:13px 0 4px}.recipe-card p{font-size:11px;line-height:1.55;color:#718696;margin:0;min-height:34px}.card-meta{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #edf2f5;padding-top:11px;margin-top:12px;font-size:10px;color:#668093}.card-action{color:#0781a6;font-weight:700}.detail{position:sticky;top:22px;background:#fff;border:1px solid #d8e8ef;border-radius:20px;box-shadow:0 14px 35px #214d6010;overflow:hidden;min-height:470px}.detail-top{padding:23px 23px 19px;background:linear-gradient(135deg,#e5f5fa,#f5fbfc);border-bottom:1px solid #e2edf1}.detail-label{font-size:10px;font-weight:800;letter-spacing:.13em;color:#1484a5}.detail-empty{text-align:center;padding:74px 32px 54px}.empty-illustration{width:76px;height:76px;border-radius:24px;background:#e4f5f8;color:#1284a5;display:grid;place-items:center;margin:0 auto 18px;font-size:34px;box-shadow:inset 0 0 0 1px #ceeaf0}.detail-empty h3{font:700 16px Manrope,sans-serif;margin:0 0 8px;color:#183247}.detail-empty p{font-size:12px;line-height:1.65;color:#7a8e9d;margin:0 auto;max-width:245px}.detail-content{padding:20px 23px 24px}.detail-title-row{display:flex;align-items:center;gap:12px}.detail-food-icon{width:48px;height:48px;border-radius:15px;background:#e8f6f9;display:grid;place-items:center;font-size:25px}.detail-title{font:800 19px/1.3 Manrope,sans-serif;letter-spacing:-.04em;margin:0;color:#173247}.detail-desc{font-size:12px;color:#708696;margin:4px 0 0}.detail-rule{height:1px;background:#eaf0f3;margin:19px 0}.section-mini{font-size:10px;font-weight:800;letter-spacing:.11em;color:#688194;margin-bottom:11px}.ingredient-list{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ingredient{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 11px;border:1px solid #e5edf1;border-radius:12px;background:#fbfdfe;font-size:11px;color:#334f63}.ingredient strong{color:#087da7;font-size:10px;white-space:nowrap}.steps{display:flex;flex-direction:column;gap:10px}.step{display:flex;align-items:flex-start;gap:10px;font-size:11px;line-height:1.55;color:#546f81}.step-num{flex:0 0 22px;width:22px;height:22px;border-radius:8px;background:#e1f3f7;color:#087da7;display:grid;place-items:center;font-size:10px;font-weight:800}.detail-footer{display:flex;align-items:center;justify-content:space-between;margin-top:18px;padding-top:13px;border-top:1px solid #eaf0f3;font-size:10px;color:#788d9a}.footnote{max-width:1288px;margin:26px auto 0;font-size:10px;color:#91a2ad;display:flex;align-items:center;gap:7px}.footer-dot{color:#1684a5}@media(max-width:920px){.topbar{margin-bottom:30px}.nav{display:none}.results-layout{grid-template-columns:1fr}.detail{position:static;min-height:0}.detail-empty{padding:38px 24px}.privacy{display:none}}@media(max-width:600px){.page{padding:16px 15px 38px}.topbar{margin-bottom:27px}.brand-mark{width:38px;height:38px}.profile{padding:9px 12px}.intro{display:block;margin-bottom:17px}h1{font-size:31px}.subtitle{font-size:13px;line-height:1.55}.search-panel{padding:10px;border-radius:15px}.search-row{gap:7px}.search-button{padding:11px 12px;font-size:11px}.search-input{font-size:13px}.search-bottom{padding:0 2px}.hint{width:100%}.results-layout{margin-top:24px;gap:15px}.results-head{align-items:start}.results-title{font-size:18px}.cards{grid-template-columns:1fr;gap:9px}.recipe-card{padding:13px}.recipe-card p{min-height:0}.detail-top,.detail-content{padding:18px}.ingredient-list{grid-template-columns:1fr}.count{font-size:10px}}
</style>
</helmet>
<div class="page"><header class="topbar"><div class="brand"><div class="brand-mark">✦</div><div><div class="brand-name">MediMind</div><div class="brand-caption">Chăm sóc sức khỏe mỗi ngày</div></div></div><nav class="nav"><span>Trang chủ</span><span>Trợ lý sức khỏe</span><span>Đọc đơn thuốc</span><span class="nav-active">Gợi ý dinh dưỡng</span></nav><div class="profile">☻ &nbsp; Tài khoản</div></header>
<main class="main"><section class="intro"><div><div class="eyebrow"><span class="dot"></span> GỢI Ý DINH DƯỠNG CÁ NHÂN</div><h1>Hôm nay bạn muốn ăn gì?</h1><p class="subtitle">Chia sẻ tâm trạng hoặc tình trạng của bạn. Chọn món hợp ý rồi xem nguyên liệu.</p></div><div class="privacy">✦ Gợi ý tham khảo, dễ chọn và dễ làm</div></section>
<section class="search-panel"><div class="search-row"><span class="search-icon">⌕</span><input class="search-input" value="{{ query }}" placeholder="Ví dụ: mất ngủ, mệt mỏi, đau họng, muốn ăn nhẹ…" onChange="{{ updateQuery }}"><button class="search-button" type="button" onClick="{{ submitQuery }}">Tìm gợi ý <span aria-hidden="true"> →</span></button></div><div class="search-bottom"><span class="hint">Hoặc chọn nhanh</span><sc-for list="{{ moods }}" as="mood" hint-placeholder-count="3"><button type="button" class="quick-chip {{ mood.className }}" onClick="{{ mood.pick }}">{{ mood.icon }} {{ mood.label }}</button></sc-for></div></section>
<section class="results-layout"><div><div class="results-head"><div><div class="results-kicker">GỢI Ý HÔM NAY</div><h2 class="results-title">Món ăn & thức uống cho <span style="color:#087da7">{{ activeMood }}</span></h2><div class="results-caption">Chọn một thẻ để xem nguyên liệu và cách làm.</div></div><div class="count">{{ recipeCount }} gợi ý</div></div><div class="cards"><sc-for list="{{ recipes }}" as="recipe" hint-placeholder-count="4"><button type="button" class="recipe-card {{ recipe.className }}" onClick="{{ recipe.pick }}"><div class="card-top"><span class="food-icon">{{ recipe.icon }}</span><span class="tag">{{ recipe.category }}</span></div><h3>{{ recipe.title }}</h3><p>{{ recipe.description }}</p><div class="card-meta"><span>◷ {{ recipe.time }} · {{ recipe.note }}</span><span class="card-action">{{ recipe.action }}</span></div></button></sc-for></div></div>
<aside class="detail"><div class="detail-top"><div class="detail-label">BƯỚC TIẾP THEO</div><div style="font:700 15px Manrope,sans-serif;margin-top:7px;color:#183247">Xem món bạn đã chọn</div></div><sc-if value="{{ hasSelection }}" hint-placeholder-val="false"><div class="detail-content"><div class="detail-title-row"><div class="detail-food-icon">{{ selected.icon }}</div><div><h2 class="detail-title">{{ selected.title }}</h2><p class="detail-desc">{{ selected.description }}</p></div></div><div class="detail-rule"></div><div class="section-mini">NGUYÊN LIỆU · 1 KHẨU PHẦN</div><div class="ingredient-list"><sc-for list="{{ selected.ingredients }}" as="ingredient" hint-placeholder-count="4"><div class="ingredient"><span>{{ ingredient.name }}</span><strong>{{ ingredient.amount }}</strong></div></sc-for></div><div class="detail-rule"></div><div class="section-mini">CÁCH LÀM</div><div class="steps"><sc-for list="{{ selected.steps }}" as="step" hint-placeholder-count="3"><div class="step"><span class="step-num">{{ step.number }}</span><span>{{ step.text }}</span></div></sc-for></div><div class="detail-footer"><span>◷ {{ selected.time }}</span><span>Gợi ý dinh dưỡng tham khảo</span></div></div></sc-if><sc-if value="{{ showEmpty }}" hint-placeholder-val="true"><div class="detail-empty"><div class="empty-illustration">♧</div><h3>Chọn món hợp ý bạn</h3><p>Chạm vào một thẻ gợi ý bên trái để xem nguyên liệu và cách làm chi tiết.</p></div></sc-if></aside></section><div class="footnote"><span class="footer-dot">●</span> Thông tin chỉ mang tính tham khảo dinh dưỡng, không thay thế tư vấn y tế chuyên khoa.</div></main></div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"$preview":{"width":1440,"height":1100}}'>
class Component extends DCLogic {
  constructor(props) {
    super(props);
    this.state = { query: 'Mất ngủ', activeMood: 'Mất ngủ', selectedId: '' };
  }
  renderVals() {
    const meals = [
      {id:'oat',icon:'🥣',category:'MÓN ĂN',title:'Cháo yến mạch hạt sen',description:'Ấm bụng, nhẹ nhàng cho buổi tối thư thái.',time:'20 phút',note:'Dễ làm',action:'Xem món →',ingredients:[{name:'Yến mạch',amount:'40 g'},{name:'Hạt sen',amount:'30 g'},{name:'Sữa tươi',amount:'150 ml'},{name:'Nước lọc',amount:'200 ml'}],steps:[{number:'1',text:'Rửa nhanh hạt sen, nấu mềm cùng nước trong khoảng 10 phút.'},{number:'2',text:'Thêm yến mạch và sữa, khuấy đều trên lửa nhỏ.'},{number:'3',text:'Nấu thêm vài phút đến độ sánh vừa ý, dùng khi còn ấm.'}]},
      {id:'egg',icon:'🍳',category:'MÓN ĂN',title:'Trứng hấp nấm mềm',description:'Bữa nhẹ ít công đoạn, vị thanh và mềm.',time:'15 phút',note:'Bữa nhẹ',action:'Xem món →',ingredients:[{name:'Trứng gà',amount:'2 quả'},{name:'Nấm hương',amount:'3 cái'},{name:'Nước ấm',amount:'100 ml'},{name:'Hành lá',amount:'1 nhánh'}],steps:[{number:'1',text:'Đánh tan trứng với nước ấm và một chút gia vị.'},{number:'2',text:'Thêm nấm đã thái nhỏ, lọc hỗn hợp qua rây.'},{number:'3',text:'Hấp lửa nhỏ khoảng 10 phút đến khi mặt trứng vừa đông.'}]},
      {id:'tea',icon:'🫖',category:'THỨC UỐNG',title:'Trà hoa cúc mật ong',description:'Hương hoa dịu, dễ chuẩn bị trước giờ nghỉ.',time:'8 phút',note:'Ấm nhẹ',action:'Xem món →',ingredients:[{name:'Hoa cúc khô',amount:'4 bông'},{name:'Nước nóng',amount:'250 ml'},{name:'Mật ong',amount:'1 thìa cà phê'},{name:'Lát chanh',amount:'1 lát'}],steps:[{number:'1',text:'Tráng hoa cúc bằng một ít nước nóng rồi bỏ nước tráng.'},{number:'2',text:'Hãm hoa trong 250 ml nước nóng khoảng 5 phút.'},{number:'3',text:'Đợi trà nguội bớt, thêm mật ong và thưởng thức.'}]},
      {id:'milk',icon:'🥛',category:'THỨC UỐNG',title:'Sữa ấm quế nhẹ',description:'Một lựa chọn ấm áp, nguyên liệu quen thuộc.',time:'5 phút',note:'Nhanh gọn',action:'Xem món →',ingredients:[{name:'Sữa tươi',amount:'200 ml'},{name:'Bột quế',amount:'¼ thìa cà phê'},{name:'Mật ong',amount:'1 thìa cà phê'}],steps:[{number:'1',text:'Làm ấm sữa ở lửa nhỏ, không đun sôi.'},{number:'2',text:'Thêm một chút bột quế và khuấy đều.'},{number:'3',text:'Để nguội vừa uống rồi thêm mật ong nếu thích.'}]}
    ];
    const activeMood = this.state.activeMood || 'Mất ngủ';
    const recipes = meals.map((recipe) => ({...recipe, className: this.state.selectedId === recipe.id ? 'chosen' : '', pick: () => this.setState({selectedId:recipe.id})}));
    const selected = meals.find((recipe) => recipe.id === this.state.selectedId) || meals[0];
    const hasSelection = Boolean(this.state.selectedId);
    return {
      query: this.state.query,
      activeMood,
      recipeCount: recipes.length,
      recipes,
      selected,
      hasSelection,
      showEmpty: !hasSelection,
      updateQuery: (event) => this.setState({query: event.target.value}),
      submitQuery: () => this.setState({activeMood: this.state.query.trim() || 'thể trạng của bạn', selectedId: ''}),
      moods: [
        {label:'Mất ngủ',icon:'☾',className:activeMood==='Mất ngủ'?'active':'',pick:()=>this.setState({query:'Mất ngủ',activeMood:'Mất ngủ',selectedId:''})},
        {label:'Căng thẳng',icon:'✳',className:activeMood==='Căng thẳng'?'active':'',pick:()=>this.setState({query:'Căng thẳng',activeMood:'Căng thẳng',selectedId:''})},
        {label:'Đầy bụng',icon:'⌁',className:activeMood==='Đầy bụng'?'active':'',pick:()=>this.setState({query:'Đầy bụng',activeMood:'Đầy bụng',selectedId:''})},
        {label:'Đau họng',icon:'♡',className:activeMood==='Đau họng'?'active':'',pick:()=>this.setState({query:'Đau họng',activeMood:'Đau họng',selectedId:''})}
      ]
    };
  }
}
</script>
</body>
</html>
