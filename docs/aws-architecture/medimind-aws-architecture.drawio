alue="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8624;strokeWidth=2;dashed=1;endArrow=none;endFill=0;startArrow=none;startFill=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1560" y="666" /><mxPoint as="targetPoint" x="1472" y="892" /><Array as="points"><mxPoint x="1472" y="666" /></Array></mxGeometry></mxCell><mxCell id="badge_01" value="&lt;b&gt;01&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="428" y="246" width="28" height="28" /></mxCell><mxCell id="badge_02" value="&lt;b&gt;02&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="428" y="421" width="28" height="28" /></mxCell><mxCell id="badge_03" value="&lt;b&gt;03&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#B01C33;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="534" width="28" height="28" /></mxCell><mxCell id="badge_04" value="&lt;b&gt;04&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="668" y="421" width="28" height="28" /></mxCell><mxCell id="badge_05" value="&lt;b&gt;05&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="1131" y="421" width="28" height="28" /></mxCell><mxCell id="badge_06" value="&lt;b&gt;06&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="1511" y="421" width="28" height="28" /></mxCell><mxCell id="badge_07" value="&lt;b&gt;07&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0073BB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="1751" y="281" width="28" height="28" /></mxCell><mxCell id="badge_08" value="&lt;b&gt;08&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0073BB;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="2081" y="1034" width="28" height="28" /></mxCell><mxCell id="badge_09" value="&lt;b&gt;09&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#414750;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="571" y="954" width="28" height="28" /></mxCell><mxCell id="badge_10" value="&lt;b&gt;10&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#414750;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="571" y="1134" width="28" height="28" /></mxCell><mxCell id="badge_11" value="&lt;b&gt;11&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2E6B19;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="1571" y="878" width="28" height="28" /></mxCell><mxCell id="legend_box" value="&lt;b&gt;LEGEND:&lt;/b&gt; &amp;nbsp; &amp;#8212;&amp;#9654; User &amp;amp; Backend Traffic &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; - - &amp;#9654; Web Security &amp;amp; TLS &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#0073BB'&gt;&amp;#8212;&amp;#9654; External API &amp;amp; Email&lt;/font&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#545B64'&gt;- - &amp;#9654; CI/CD &amp;amp; Infrastructure Mgmt&lt;/font&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#3F8624'&gt;- - &amp;#9654; Automated Backup&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#FFFFFF;strokeColor=#D5DBDB;fontFamily=Arial;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1246" width="2480" height="52" /></mxCell><mxCell id="df_title" value="&lt;b&gt;DATA FLOW DESCRIPTION&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1320" width="400" height="26" /></mxCell><mxCell id="df_table" value="&lt;table border='1' cellspacing='0' cellpadding='5' style='border-collapse:collapse;width:100%;font-family:Arial;font-size:11px;border-color:#D5DBDB;'&gt;&lt;tr style='background-color:#232F3E;color:#FFFFFF;font-weight:bold;'&gt;&lt;th width='70' align='center'&gt;No.&lt;/th&gt;&lt;th width='320' align='left'&gt;Data Flow&lt;/th&gt;&lt;th align='left'&gt;Description&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;DNS Resolution&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Users enter the MediMind website domain in a web browser, and Amazon Route 53 resolves the domain name.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8F9FA;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Website Access&lt;/b&gt;&lt;/td&gt;&lt;td&gt;The web browser establishes an encrypted HTTPS connection to Amazon CloudFront to access the MediMind website.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Web Security &amp;amp; TLS&lt;/b&gt;&lt;/td&gt;&lt;td&gt;AWS WAF inspects incoming requests against security rules while AWS Certificate Manager provisions public TLS certificates.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8F9FA;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Frontend &amp;amp; Origin Delivery&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Amazon CloudFront serves cached website assets and forwards dynamic requests through the Internet Gateway to the Load Balancer.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;05&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Backend Processing&lt;/b&gt;&lt;/td&gt;&lt;td&gt;The Application Load Balancer checks service health and routes requests to the Backend application running in Docker on Amazon EC2.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8F9FA;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Database &amp;amp; Persistent Storage&lt;/b&gt;&lt;/td&gt;&lt;td&gt;The Backend reads and writes application data in Amazon RDS for PostgreSQL and stores ChromaDB vectors and uploads on Amazon EBS.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;07&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;External API Integration&lt;/b&gt;&lt;/td&gt;&lt;td&gt;The Backend integrates over HTTPS with Google Gemini API, Google OAuth 2.0 &amp;amp; Maps, Leaflet / OpenStreetMap, and Twilio / SpeedSMS.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8F9FA;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Transactional Email Delivery&lt;/b&gt;&lt;/td&gt;&lt;td&gt;The Backend sends OTP verification codes and appointment confirmation emails to the User Email Inbox via Amazon SES.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;09&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;CI/CD Deployment&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GitHub Actions runs quality checks, builds and pushes the Docker image to Amazon ECR, and Amazon EC2 pulls the image to deploy.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#F8F9FA;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Infrastructure Management&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DevOps manages Amazon EC2 via AWS Systems Manager Session Manager without SSH, using Parameter Store secrets and AWS IAM roles.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background-color:#FFFFFF;color:#232F3E;'&gt;&lt;td align='center'&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Automated Data Backup&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Scheduled backup tasks archive encrypted PostgreSQL database dumps and ChromaDB vector snapshots into Amazon S3.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1350" width="2480" height="380" /></mxCell></root></mxGraphModel></diagram></mxfile>