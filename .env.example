# ==============================================================
# CẤU HÌNH MÁY CHỦ WEB (FLASK SERVER CONFIG)
# ==============================================================
PORT=8000
FLASK_DEBUG=false

# ==============================================================
# CẤU HÌNH GOOGLE GEMINI AI (MIỄN PHÍ & TỐC ĐỘ CAO)
# Lấy Key tại: https://aistudio.google.com/app/apikey
# ==============================================================
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================
# CƠ SỞ DỮ LIỆU VECTOR & GROUNDED RAG (PINECONE)
# ==============================================================
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=medical-chatbot

# ==============================================================
# HẠ TẦNG CLOUD AWS (S3, ECR & APP RUNNER)
# ==============================================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET_NAME=medimind-records-storage
