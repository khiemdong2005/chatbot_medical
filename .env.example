# ==============================================================
# CẤU HÌNH MÁY CHỦ WEB (FLASK SERVER CONFIG)
# ==============================================================
PORT=8000
FLASK_DEBUG=false

# ==============================================================
# CẤU HÌNH GOOGLE GEMINI AI (MIỄN PHÍ & TỐC ĐỘ CAO)
# Tạo API Key chuẩn tại: https://aistudio.google.com/app/apikey
# Use a Gemini API key / Authentication Key issued by Google AI Studio.
# Credential formats may vary; do not validate solely by prefix.
# ==============================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ==============================================================
# CƠ SỞ DỮ LIỆU VECTOR & GROUNDED RAG (CHROMA LOCAL)
# ==============================================================
VECTOR_DB_PATH=./medical_vectordb

# ==============================================================
# CROSS-LANGUAGE RAG QUERY EXPANSION (LOCAL RUNTIME)
# ==============================================================
RAG_QUERY_EXPANSION_ENABLED=false
RAG_QUERY_EXPANSION_PROVIDER=gemini
RAG_QUERY_EXPANSION_TIMEOUT_SECONDS=3
