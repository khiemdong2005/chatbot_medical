# Flask website (run: python app.py)
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=false

# Generate locally with: python -c "import secrets; print(secrets.token_hex(32))"
# Set a private value and keep it stable between server restarts.
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Gemini. Supply your own key; the selected model must be available to your account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# SQLAlchemy. Relative SQLite paths use the Flask instance directory.
DATABASE_URL=sqlite:///medimind.db
SEED_DEMO_ACCOUNTS=false

# ChromaDB is built locally by python ingest.py under medical_vectordb/.
# Lexical retrieval is the default; vector queries can need an embedding model.
RAG_VECTOR_SEARCH_ENABLED=false
RAG_ACCEPTANCE_THRESHOLD=1.35

# Optional Maps JavaScript API. Leave blank to use the embedded map.
GOOGLE_MAPS_API_KEY=

# Optional Google OAuth sign-in; register the exact redirect URI with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Optional email OTP delivery.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_NAME=MediMind
