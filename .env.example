# ==============================================================================
# 🩺 MEDIMIND CLINICAL AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị phù hợp.
#   cp .env.example .env
# Các trường đánh dấu [Optional] có thể để trống hoặc dùng giá trị mặc định.
# ==============================================================================

# ==============================================================================
# 1. BẢO MẬT & CƠ SỞ DỮ LIỆU (SECURITY & DATABASE)
# ==============================================================================
# Bắt buộc trong môi trường Production. Trong Local Dev nếu để trống sẽ dùng development fallback.
# Sinh khóa ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_key_here

# [Optional] Chuỗi kết nối CSDL SQLAlchemy.
# Mặc định tự động trỏ đến: sqlite:///./instance/medimind.db (tương thích volume Docker ./instance:/app/instance)
DATABASE_URL=sqlite:///./instance/medimind.db

# [Optional] Bật cờ Secure cho Session Cookie (Bắt buộc bật trong HTTPS Production)
# VULN-06: Thiết lập SESSION_COOKIE_SECURE=true khi triển khai với HTTPS để bảo vệ session cookie.
# Giữ SESSION_COOKIE_SECURE=false trong môi trường development cục bộ (HTTP localhost) là an toàn.
# Cảnh báo khởi động sẽ được ghi log nếu non-development mà SESSION_COOKIE_SECURE=false.
# Production (FLASK_ENV=production): BẮT BUỘC phải đặt SESSION_COOKIE_SECURE=true
# Development (FLASK_ENV=development): false là chấp nhận được (HTTP localhost)
SESSION_COOKIE_SECURE=false

# [Optional] Thời gian sống tối đa của phiên đăng nhập (phút, mặc định 120 phút)
SESSION_LIFETIME_MINUTES=120

# [Optional] Kiểm soát tin cậy Proxy ngược (Nginx / Cloud ALB / Reverse Proxy). Mặc định false (chống giả mạo IP)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# [Optional] Chính sách thời gian lưu trữ tài liệu tạm (Giờ)
OCR_DRAFT_RETENTION_HOURS=24
TEMP_UPLOAD_RETENTION_HOURS=24

# [Optional] Khởi tạo tài khoản mẫu cho Local Development (Tuyệt đối không bật trong Production)
DEV_SEED_USERS=false
# DEV_SEED_PASSWORD=your_dev_seed_password_here
SEED_DEMO_ACCOUNTS=false

# [Optional] Danh sách nguồn gốc CORS được phép (phân tách bởi dấu phẩy). Mặc định Production là rỗng (fail-safe)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000

# ==============================================================================
# 2. CẤU HÌNH MÁY CHỦ WEB (WEB SERVER & RUNTIME)
# ==============================================================================
PORT=8000
HOST=0.0.0.0
FLASK_ENV=development
FLASK_DEBUG=false

# ==============================================================================
# 3. GOOGLE GEMINI AI (CORE LLM PROVIDER)
# ==============================================================================
# Khóa API chuẩn từ Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# [Optional] Tách biệt API Key theo từng phân hệ (để chia tách quota / billing nếu cần)
# GEMINI_CHAT_API_KEY=your_chat_gemini_api_key_here
# GEMINI_NUTRITION_API_KEY=your_nutrition_gemini_api_key_here

# [Optional] Chỉ định model LLM cho từng tác vụ chuyên biệt
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EXPANSION_MODEL=gemini-flash-lite-latest
GEMINI_NUTRITION_MODEL=gemini-flash-lite-latest
OCR_MODEL=gemini-flash-lite-latest
INTERPRETATION_MODEL=gemini-flash-lite-latest

# ==============================================================================
# 4. TIMEOUTS, RETRY & CIRCUIT BREAKER
# ==============================================================================
# Thời gian chờ tối đa cho từng nhóm tác vụ (giây)
GEMINI_GENERATION_TIMEOUT_SECONDS=25.0
QUERY_EXPANSION_TIMEOUT_SECONDS=3.0
OCR_AI_TIMEOUT_SECONDS=30.0

# Chính sách thử lại (Retry Policy with Exponential Backoff & Jitter)
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=4.0

# Bộ ngắt mạch bảo vệ hệ thống (Circuit Breaker Workload Isolation)
AI_CIRCUIT_BREAKER_ENABLED=true
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=30.0

# ==============================================================================
# 5. GROUNDED RAG & VECTOR SEARCH (MEDLINEPLUS)
# ==============================================================================
VECTOR_DB_PATH=./medical_vectordb
RAG_VECTOR_SEARCH_ENABLED=false
RAG_ACCEPTANCE_THRESHOLD=0.35

# [Optional] Mở rộng truy vấn đa ngữ y tế (Cross-language Query Expansion)
RAG_QUERY_EXPANSION_ENABLED=false
RAG_QUERY_EXPANSION_PROVIDER=gemini
RAG_QUERY_EXPANSION_TIMEOUT_SECONDS=3.0

# [Optional] Reranker model (BGE Reranker)
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL_PATH=BAAI/bge-reranker-v2-m3
RAG_RERANK_TIMEOUT_SECONDS=3.0

# [Optional] Ingestion Pipeline & Quality Normalization (Phase 6.1)
INGEST_CHUNK_MAX_CHARS=2000
INGEST_CHUNK_OVERLAP_CHARS=200
INGEST_MIN_CHUNK_CHARS=200
INGEST_BATCH_SIZE=50
INGEST_CHUNKING_VERSION=v2_sentence_contextual
INGEST_EMBEDDING_MODEL=all-MiniLM-L6-v2
INGEST_EMBEDDING_DIMENSION=384

# ==============================================================================
# 6. XÁC THỰC GOOGLE OAUTH 2.0 [Optional]
# ==============================================================================
# Tạo OAuth Client ID tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# [Optional] Google Maps API Key để hiển thị bản đồ cơ sở khám chữa bệnh
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==============================================================================
# 7. CỔNG GỬI TIN NHẮN SMS OTP NỘI ĐỊA VIỆT NAM [Optional]
# ==============================================================================
# SpeedSMS (Cổng SMS Việt Nam)
SPEEDSMS_AUTH_TOKEN=your_speedsms_token_here
SPEEDSMS_SMS_TYPE=2
SPEEDSMS_SENDER=
# Ghi chú: Đã loại bỏ hoàn toàn Twilio SMS (Cổng quốc tế) để phòng chống lạm dụng cước phí quốc tế.

# ==============================================================================
# 8. MÁY CHỦ GỬI EMAIL SMTP [Optional]
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_SENDER_NAME="MediMind Clinical AI"
SMTP_USE_TLS=true

# ==============================================================================
# 9. GIÁM SÁT & OBSERVABILITY DASHBOARD
# ==============================================================================
SYSTEM_METRICS_ENABLED=true

# ==============================================================================
# 10. OPENROUTER AI PROVIDER (Thay thế Google Gemini bằng model :free / đa model)
# ==============================================================================
# Đặt AI_PROVIDER=openrouter để chuyển toàn bộ 5 tính năng AI sang OpenRouter API
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_CHAT_MODEL=openrouter/free
# Bật khi endpoint của model chat hỗ trợ JSON Schema nghiêm ngặt.
# OPENROUTER_CHAT_JSON_SCHEMA=1
# Tùy chọn giới hạn nhà cung cấp theo chính sách lưu dữ liệu.
# OPENROUTER_CHAT_DATA_COLLECTION=deny
# OPENROUTER_CHAT_ZDR=1
OPENROUTER_INTERPRETATION_MODEL=openrouter/free
OPENROUTER_NUTRITION_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_NUTRITION_TIMEOUT_SECONDS=90
OPENROUTER_EXPANSION_MODEL=openrouter/free
OPENROUTER_OCR_MODEL=nvidia/nemotron-3.5-super-vl:free
